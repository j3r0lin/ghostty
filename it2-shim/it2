def cmd_session_show(args):
    self_id = args.session or _self_session_id()
    if not self_id:
        print("no session specified and ITERM_SESSION_ID not set", file=sys.stderr)
        sys.exit(1)

    body = f'''
var t = resolve("{_escape_js(self_id)}");
if (!t) return "NOTFOUND";
var tId = t.propertyWithCode(0x49442020).get.js;
var tName = t.propertyWithCode(0x706e616d).get.js;
var tCwd = t.propertyWithCode(0x47776472).get.js;
var f = t.propertyWithCode(0x47546672).get;
var frame = [f.objectForKey("x").js, f.objectForKey("y").js, f.objectForKey("w").js, f.objectForKey("h").js].join(",");
var tabIdx = 0, paneIdx = 0, paneCount = 0;
var wins = app.elementArrayWithCode(0x47776e64);
for (var i = 0; i < wins.count; i++) {{
  var tabs = wins.objectAtIndex(i).elementArrayWithCode(0x47746162);
  for (var j = 0; j < tabs.count; j++) {{
    var tb = tabs.objectAtIndex(j);
    var terms = tb.elementArrayWithCode(0x4774726d);
    for (var k = 0; k < terms.count; k++) {{
      if (terms.objectAtIndex(k).propertyWithCode(0x49442020).get.js === tId) {{
        tabIdx = tb.propertyWithCode(0x70696478).get.js;
        paneIdx = k + 1;
        paneCount = terms.count;
      }}
    }}
  }}
}}
return [tId, tName, tCwd, frame, tabIdx, paneIdx, paneCount].join("\\n");'''
    r = run_jxa(body, self_id)
    if r.returncode != 0:
        msg = _friendly_error(r.stderr, self_id) or f"applescript error: {r.stderr.strip()}"
        print(msg, file=sys.stderr)
        sys.exit(1)
    if r.stdout.strip() == "NOTFOUND":
        print(f"session not found: {self_id}\nUse 'it2 session list' to see available sessions.",
              file=sys.stderr)
        sys.exit(1)

    lines = r.stdout.strip().splitlines()
    if len(lines) < 7:
        print("unexpected output", file=sys.stderr)
        sys.exit(1)

    tid, name, cwd, frame, tab_idx, pane_idx, pane_count = lines[:7]

    if getattr(args, "json", False):
        fx, fy, fw, fh = frame.split(",")
        print(json.dumps({
            "session_id": tid,
            "name": name,
            "working_directory": cwd,
            "frame": {"x": int(fx), "y": int(fy), "w": int(fw), "h": int(fh)},
            "tab": int(tab_idx),
            "pane": int(pane_idx),
            "pane_count": int(pane_count),
        }, indent=2))
    else:
        cwd_short = "~/" + "/".join(cwd.split("/")[3:]) if cwd.startswith("/Users/") else cwd
        print(f"Session:  {tid}")
        if name:
            print(f"Name:     {name}")
        print(f"CWD:      {cwd_short}")
        print(f"Tab:      {tab_idx}  Pane: {pane_idx}/{pane_count}")


