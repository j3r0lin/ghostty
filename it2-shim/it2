def _session_id_completer(**_kwargs):
    """Tab-completion: return available Ghostty terminal IDs."""
    try:
        r = run_jxa('''
var terms = app.elementArrayWithCode(0x4774726d);
var lines = [];
for (var i = 0; i < terms.count; i++) {
  lines.push(terms.objectAtIndex(i).propertyWithCode(0x49442020).get.js);
}
return lines.join("\\n");''')
        if r.returncode == 0:
            return [s for s in r.stdout.strip().splitlines() if s]
    except Exception:
        pass
    return []


def _attach_session_completer(parser):
    """Recursively attach session-id completer to every -s/--session arg."""
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            for sub_parser in action.choices.values():
                _attach_session_completer(sub_parser)
        elif "-s" in action.option_strings or "--session" in action.option_strings:
            action.completer = _session_id_completer


def build_parser():
    top = argparse.ArgumentParser(prog="it2", description="Ghostty terminal session control")
    sp = top.add_subparsers(dest="group", help="command group")
    session = sp.add_parser("session", help="manage terminal sessions")
    sub = session.add_subparsers(dest="subcmd", help="session subcommand")

    # list
    p = sub.add_parser("list", help="list all terminal session IDs")
    p.add_argument("--json", action="store_true", help="output as JSON")
    p.set_defaults(func=cmd_session_list)

    # split
    p = sub.add_parser("split", help="split a terminal pane")
    p.add_argument("-v", "--vertical", action="store_true", help="split vertically (right)")
    p.add_argument("-s", "--session", metavar="ID", help="source terminal (default: focused)")
    p.add_argument("-p", "--profile", metavar="CMD", help="command to run in new pane")
    p.add_argument("--focus", action="store_true", help="focus the new pane after split")
    p.set_defaults(func=cmd_session_split)

    # run
    p = sub.add_parser("run", help="send a command and press Enter")
    p.add_argument("-s", "--session", metavar="ID", help="target terminal (default: focused)")
    p.add_argument("command", nargs=argparse.REMAINDER, help="command to execute")
    p.set_defaults(func=cmd_session_run)

    # send
    p = sub.add_parser("send", help="send text without pressing Enter")
    p.add_argument("-s", "--session", metavar="ID", help="target terminal (default: focused)")
    p.add_argument("-a", "--all", action="store_true", help="send to all terminals")
    p.add_argument("text", nargs=argparse.REMAINDER, help="text to send")
    p.set_defaults(func=cmd_session_send)

    # focus
    p = sub.add_parser("focus", help="focus a terminal pane")
    p.add_argument("-s", "--session", metavar="ID", help="terminal to focus")
    p.add_argument("session_id", nargs="?", help="terminal to focus (positional)")
    p.set_defaults(func=cmd_session_focus)

    # close
    p = sub.add_parser("close", help="close a terminal pane")
    p.add_argument("-f", "--force", action="store_true", help="force close (accepted but ignored)")
    p.add_argument("-s", "--session", metavar="ID", help="terminal to close")
    p.set_defaults(func=cmd_session_close)

    # clear
    p = sub.add_parser("clear", help="clear the terminal screen")
    p.add_argument("-s", "--session", metavar="ID", help="target terminal (default: focused)")
    p.set_defaults(func=cmd_session_clear)

    # tabs
    p = sub.add_parser("tabs", help="list all tabs in frontmost window")
    p.set_defaults(func=cmd_session_tabs)

    # layout
    p = sub.add_parser("layout", help="show split layout of a tab")
    p.add_argument("--tab", "-t", type=int, metavar="N", default=None,
                   help="tab index (1-based, default: selected tab)")
    p.add_argument("--verbose", "-v", action="store_true",
                   help="show terminal IDs")
    p.set_defaults(func=cmd_session_layout)

    # show
    p = sub.add_parser("show", help="show current session info")
    p.add_argument("-s", "--session", metavar="ID", help="target terminal (default: current)")
    p.add_argument("--json", action="store_true", help="output as JSON")
    p.set_defaults(func=cmd_session_show)

    # read
    p = sub.add_parser("read", help="display screen contents")
    p.add_argument("-s", "--session", metavar="ID", help="target terminal (default: focused)")
    p.add_argument("-n", "--lines", type=int, metavar="N", help="number of lines to read")
    p.set_defaults(func=cmd_session_read)

    # capture
    p = sub.add_parser("capture", help="capture screen to file")
    p.add_argument("-s", "--session", metavar="ID", help="target terminal (default: focused)")
    p.add_argument("-o", "--output", required=True, metavar="FILE", help="output file path")
    p.add_argument("--history", action="store_true", help="not supported on Ghostty (visible screen only)")
    p.set_defaults(func=cmd_session_capture)

    # set-name
    p = sub.add_parser("set-name", help="set session name")
    p.add_argument("-s", "--session", metavar="ID", help="target terminal (default: focused)")
    p.add_argument("name", help="new session name")
    p.set_defaults(func=cmd_session_set_name)

    # copy
    p = sub.add_parser("copy", help="copy selection to clipboard")
    p.add_argument("-s", "--session", metavar="ID", help="target terminal (default: focused)")
    p.set_defaults(func=cmd_session_copy)

    return top


def main():
    raw_args = sys.argv[1:]
    _trace(f">>> it2 {' '.join(raw_args)}  (pid={os.getpid()})")

    parser = build_parser()
    if argcomplete is not None:
        _attach_session_completer(parser)
        argcomplete.autocomplete(parser)
    args = parser.parse_args(raw_args)

    if not hasattr(args, "func"):
        parser.parse_args(raw_args + ["--help"])
        return

    # Capture stdout/stderr for trace logging
    old_stdout, old_stderr = sys.stdout, sys.stderr
    sys.stdout = io.StringIO()
    sys.stderr = io.StringIO()

    exit_code = 0
    try:
        args.func(args)
    except SystemExit as e:
        exit_code = e.code if e.code is not None else 0

    out_val = sys.stdout.getvalue()
    err_val = sys.stderr.getvalue()
    sys.stdout, sys.stderr = old_stdout, old_stderr

    if out_val:
        sys.stdout.write(out_val)
    if err_val:
        sys.stderr.write(err_val)

    if out_val.strip():
        _trace(f"    stdout: {out_val.strip()}")
    if err_val.strip():
        _trace(f"    stderr: {err_val.strip()}")
    _trace(f"<<< exit {exit_code}")

    sys.exit(exit_code)


if __name__ == "__main__":
    main()
