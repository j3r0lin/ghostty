try:
    import argcomplete
except ImportError:
    argcomplete = None

_LOG_FILE = Path.home() / ".local/state/ghostty/it2-trace.log"


def _trace(msg):
    """Append a timestamped line to the trace log (noop if log dir missing)."""
    try:
        _LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        with _LOG_FILE.open("a") as f:
            f.write(f"[{datetime.now().strftime('%H:%M:%S.%f')[:-3]}] {msg}\n")
    except OSError:
        pass


_GHOSTTY_COMM = "/Ghostty.app/Contents/MacOS/ghostty"

# Resolved once per invocation. None means "not yet"; an int is the chosen pid.
_instance_pid = None


def _self_session_id():
    """Extract terminal ID from ITERM_SESSION_ID environment variable."""
    raw = os.environ.get("ITERM_SESSION_ID", "")
    return raw.split(":", 1)[1] if ":" in raw else ""


def _escape_js(text):
    """Escape a string for embedding in a JavaScript double-quoted literal."""
    return text.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n").replace("\r", "\\r")


def _ghostty_pids():
    """Return the pids of running Ghostty instances, oldest first."""
    r = subprocess.run(["ps", "-axo", "pid=,command="], capture_output=True, text=True)
    pids = []
    for line in r.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        pid_str, _, command = line.partition(" ")
        if _GHOSTTY_COMM in command:
            try:
                pids.append(int(pid_str))
            except ValueError:
                pass
    return pids


def _ancestor_ghostty_pid():
    """Pid of the Ghostty instance this process descends from, or None."""
    pid = os.getppid()
    seen = set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        r = subprocess.run(["ps", "-o", "ppid=,command=", "-p", str(pid)],
                           capture_output=True, text=True)
        lines = [l for l in r.stdout.splitlines() if l.strip()]
        if not lines:
            return None
        ppid_str, _, command = lines[-1].strip().partition(" ")
        if _GHOSTTY_COMM in command:
            return pid
        try:
            pid = int(ppid_str)
        except ValueError:
            return None
    return None


def _instance_owning(session_id, pids):
    """Pid of the instance that has a terminal with this id, or None."""
    if not session_id:
        return None
    for pid in pids:
        probe = (
            'ObjC.import("ScriptingBridge");'
            f'var a=$.SBApplication.applicationWithProcessIdentifier({pid});'
            f'var t=a.elementArrayWithCode(0x4774726d).objectWithID("{_escape_js(session_id)}");'
            'var id=t.propertyWithCode(0x49442020).get;'
            'id && id.js === "' + _escape_js(session_id) + '" ? "yes" : "no"'
        )
        r = subprocess.run(["osascript", "-l", "JavaScript", "-e", probe],
                           capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip() == "yes":
            return pid
    return None


def _select_instance(session_id):
    """Choose the Ghostty pid this invocation talks to. Resolved once."""
    global _instance_pid
    if _instance_pid is not None:
        return _instance_pid

    pid = _ancestor_ghostty_pid()
    # A session id names a terminal. The ancestor instance only wins when it
    # actually owns that terminal; otherwise follow the id to its instance.
    if session_id and (pid is None or _instance_owning(session_id, [pid]) is None):
        pid = _instance_owning(session_id, _ghostty_pids())
    if pid is None:
        pids = _ghostty_pids()
        if len(pids) == 1:
            pid = pids[0]
        elif not pids:
            print("no Ghostty instance running", file=sys.stderr)
            sys.exit(1)
        else:
            print("multiple Ghostty instances running; pass -s or set "
                  "ITERM_SESSION_ID to choose one: " +
                  ", ".join(str(p) for p in pids), file=sys.stderr)
            sys.exit(1)

    _instance_pid = pid
    _trace(f"    instance: pid {pid}")
    return pid


def run_jxa(body, session_id=None):
    """Run a JavaScript snippet against the selected Ghostty instance.

    `body` is JavaScript source. It runs with `app` bound to the
    ScriptingBridge application for the chosen pid, and may `return` a
    string. The snippet is wrapped so it returns that string on stdout.
    """
    pid = _select_instance(session_id)
    script = (
        'ObjC.import("Foundation");\n'
        'ObjC.import("ScriptingBridge");\n'
        f'var PID = {pid};\n'
        'var app = $.SBApplication.applicationWithProcessIdentifier(PID);\n'
        'function targetFor(pid) {\n'
        '  return $.NSAppleEventDescriptor.descriptorWithProcessIdentifier(pid);\n'
        '}\n'
        'function sendEvent(cls, evid, params) {\n'
        '  var ev = $.NSAppleEventDescriptor.appleEventWithEventClassEventIDTargetDescriptorReturnIDTransactionID(\n'
        '    cls, evid, targetFor(PID), 0x6e6f7265, 0);\n'
        '  for (var i = 0; i < params.length; i++) {\n'
        '    ev.setDescriptorForKeyword(params[i][1], params[i][0]);\n'
        '  }\n'
        '  return ev.sendEventWithOptionsTimeoutError(3, 60000, null);\n'
        '}\n'
        'function replyValue(reply) {\n'
        '  if (!reply) return "";\n'
        '  var d = reply.descriptorForKeyword(0x2d2d2d2d);\n'
        '  if (!d) return "";\n'
        '  var s = d.stringValue;\n'
        '  return s ? s.js : "";\n'
        '}\n'
        'function termById(id) {\n'
        '  return app.elementArrayWithCode(0x4774726d).objectWithID(id);\n'
        '}\n'
        'function termExists(id) {\n'
        '  var got = termById(id).propertyWithCode(0x49442020).get;\n'
        '  return !!(got && got.js === id);\n'
        '}\n'
        'function specifier(obj) {\n'
        '  var spec = obj.qualifiedSpecifier;\n'
        '  nullifyFrom(spec);\n'
        '  return spec;\n'
        '}\n'
        'function nullifyFrom(spec) {\n'
        '  var from = spec.descriptorForKeyword(0x66726f6d);\n'
        '  if (!from) { spec.setDescriptorForKeyword($.NSAppleEventDescriptor.nullDescriptor, 0x66726f6d); return; }\n'
        '  if (from.descriptorType === 0x6f626a20) { nullifyFrom(from); return; }\n'
        '  spec.setDescriptorForKeyword($.NSAppleEventDescriptor.nullDescriptor, 0x66726f6d);\n'
        '}\n'
        'function resolve(sessionId) {\n'
        '  if (sessionId) {\n'
        '    if (!termExists(sessionId)) return null;\n'
        '    return termById(sessionId);\n'
        '  }\n'
        '  var win = app.propertyWithCode(0x4746576e).get;\n'
        '  if (!win) return null;\n'
        '  var tab = win.propertyWithCode(0x47577354).get;\n'
        '  if (!tab) return null;\n'
        '  return tab.propertyWithCode(0x47546654).get;\n'
        '}\n'
        '(function(){\n' + body + '\n})()\n'
    )
    return subprocess.run(["osascript", "-l", "JavaScript", "-e", script],
                          capture_output=True, text=True)


def _friendly_error(stderr, session_id):
    """Return a user-friendly error message, or None."""
    err = stderr.strip()
    if "session not found" in err:
        return f"session not found: {session_id}\nUse 'it2 session list' to see available sessions."
    if "(-1719)" in err or "(-1728)" in err:
        return "target terminal not found"
    return None


def _run_and_check(body, session_id=None):
    r = run_jxa(body, session_id)
    if r.returncode != 0:
        msg = _friendly_error(r.stderr, session_id) or f"applescript error: {r.stderr.strip()}"
        print(msg, file=sys.stderr)
        sys.exit(1)
    return r


