def _list_terminals_body():
    return '''
var lines = [];
var wins = app.elementArrayWithCode(0x47776e64);
for (var i = 0; i < wins.count; i++) {
  var tabs = wins.objectAtIndex(i).elementArrayWithCode(0x47746162);
  for (var j = 0; j < tabs.count; j++) {
    var terms = tabs.objectAtIndex(j).elementArrayWithCode(0x4774726d);
    for (var k = 0; k < terms.count; k++) {
      var t = terms.objectAtIndex(k);
      lines.push([
        t.propertyWithCode(0x49442020).get.js,
        t.propertyWithCode(0x706e616d).get.js,
        t.propertyWithCode(0x47776472).get.js
      ].join("\\t"));
    }
  }
}
return lines.join("\\n");'''


def cmd_session_list(args):
    r = run_jxa(_list_terminals_body())
    if r.returncode != 0:
        sys.exit(1)
    if getattr(args, "json", False):
        sessions = []
        for line in r.stdout.strip().splitlines():
            if not line:
                continue
            parts = line.split("\t", 2)
            sessions.append({
                "session_id": parts[0],
                "name": parts[1] if len(parts) > 1 else "",
                "working_directory": parts[2] if len(parts) > 2 else "",
            })
        print(json.dumps(sessions, indent=2))
    else:
        print("Session ID")
        output = r.stdout.strip()
        if output:
            print("\n".join(line.split("\t", 1)[0] for line in output.splitlines()))


def cmd_session_split(args):
    direction = "right" if args.vertical else "down"
    sid = args.session or _self_session_id()
    dir_code = {"right": "0x47537274", "left": "0x47536c66",
                "down": "0x4753646e", "up": "0x47537570"}[direction]
    profile = getattr(args, "profile", None)
    focus_new = "true" if args.focus else "false"

    body = f'''
var t = {_target_expr(sid)};
if (!t) return "NOTFOUND";
var params = [[0x2d2d2d2d, specifier(t)], [0x47537064, $.NSAppleEventDescriptor.descriptorWithEnumCode({dir_code})]];
{"" if not profile else f'var cfgEv = sendEvent(0x47687374, 0x4e534366, []); var cfg = cfgEv.descriptorForKeyword(0x2d2d2d2d); if (cfg) {{ cfg.setDescriptorForKeyword($.NSAppleEventDescriptor.descriptorWithString("{_escape_js(profile)}"), 0x47536343); params.push([0x47537053, cfg]); }}'}
var reply = sendEvent(0x47687374, 0x53706c74, params);
var newId = "";
if (reply) {{
  for (var di = 1; di <= reply.numberOfItems; di++) {{
    if (reply.keywordForDescriptorAtIndex(di) !== 0x2d2d2d2d) continue;
    var newSpec = reply.descriptorAtIndex(di);
    for (var i = 1; i <= newSpec.numberOfItems; i++) {{
      if (newSpec.keywordForDescriptorAtIndex(i) === 0x73656c64) {{
        var seld = newSpec.descriptorAtIndex(i);
        newId = seld.stringValue ? seld.stringValue.js : "";
      }}
    }}
  }}
}}
if (newId) {{
  var newT = termById(newId);
  sendEvent(0x47687374, 0x50664163, [[0x2d2d2d2d, $.NSAppleEventDescriptor.descriptorWithString("equalize_splits")], [0x476f6e54, specifier(newT)]]);
  var focusTarget = {focus_new} ? newT : t;
  sendEvent(0x47687374, 0x46637573, [[0x2d2d2d2d, specifier(focusTarget)]]);
}}
return newId;'''
    r = _run_and_check(body, sid)
    if r.stdout.strip() == "NOTFOUND":
        print(f"session not found: {sid}\nUse 'it2 session list' to see available sessions.",
              file=sys.stderr)
        sys.exit(1)
    terminal_id = r.stdout.strip()
    if not terminal_id:
        print("unexpected empty terminal id", file=sys.stderr)
        sys.exit(1)
    print(f"Created new pane: {terminal_id}")


def cmd_session_run(args):
    cmd = " ".join(args.command)
    sid = args.session or _self_session_id()
    body = f'''
var t = {_target_expr(sid)};
if (!t) return "NOTFOUND";
var spec = specifier(t);
sendEvent(0x47687374, 0x496e5478, [[0x2d2d2d2d, $.NSAppleEventDescriptor.descriptorWithString("{_escape_js(cmd)}")], [0x47497454, spec]]);
delay(0.5);
sendEvent(0x47687374, 0x534b6579, [[0x2d2d2d2d, $.NSAppleEventDescriptor.descriptorWithString("enter")], [0x474b6554, specifier(t)]]);
return "ok";'''
    r = _run_and_check(body, sid)
    if r.stdout.strip() == "NOTFOUND":
        print(f"session not found: {sid}\nUse 'it2 session list' to see available sessions.",
              file=sys.stderr)
        sys.exit(1)


def cmd_session_send(args):
    text = " ".join(args.text)
    sid = args.session or _self_session_id()
    escaped = _escape_js(text)

    if args.all:
        body = f'''
var terms = app.elementArrayWithCode(0x4774726d);
for (var i = 0; i < terms.count; i++) {{
  sendEvent(0x47687374, 0x496e5478, [[0x2d2d2d2d, $.NSAppleEventDescriptor.descriptorWithString("{escaped}")], [0x47497454, specifier(terms.objectAtIndex(i))]]);
}}
return "ok";'''
        _run_and_check(body, sid)
        return

    body = f'''
var t = {_target_expr(sid)};
if (!t) return "NOTFOUND";
sendEvent(0x47687374, 0x496e5478, [[0x2d2d2d2d, $.NSAppleEventDescriptor.descriptorWithString("{escaped}")], [0x47497454, specifier(t)]]);
return "ok";'''
    r = _run_and_check(body, sid)
    if r.stdout.strip() == "NOTFOUND":
        print(f"session not found: {sid}\nUse 'it2 session list' to see available sessions.",
              file=sys.stderr)
        sys.exit(1)


def cmd_session_clear(args):
    sid = args.session or _self_session_id()
    body = f'''
var t = {_target_expr(sid)};
if (!t) return "NOTFOUND";
var spec = specifier(t);
var key = $.NSAppleEventDescriptor.descriptorWithString("l");
var mods = $.NSAppleEventDescriptor.descriptorWithString("control");
sendEvent(0x47687374, 0x534b6579, [[0x2d2d2d2d, key], [0x474b654d, mods], [0x474b6541, $.NSAppleEventDescriptor.descriptorWithEnumCode(0x47497072)], [0x474b6554, spec]]);
delay(0.05);
sendEvent(0x47687374, 0x534b6579, [[0x2d2d2d2d, key], [0x474b654d, mods], [0x474b6541, $.NSAppleEventDescriptor.descriptorWithEnumCode(0x4749726c)], [0x474b6554, specifier(t)]]);
return "ok";'''
    r = _run_and_check(body, sid)
    if r.stdout.strip() == "NOTFOUND":
        print(f"session not found: {sid}\nUse 'it2 session list' to see available sessions.",
              file=sys.stderr)
        sys.exit(1)


def cmd_session_focus(args):
    session_id = args.session or args.session_id
    if not session_id:
        sys.exit(0)

    body = f'''
var t = resolve("{_escape_js(session_id)}");
if (!t) return "NOTFOUND";
sendEvent(0x47687374, 0x46637573, [[0x2d2d2d2d, specifier(t)]]);
return "ok";'''
    run_jxa(body, session_id)


